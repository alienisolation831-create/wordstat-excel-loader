# Copy to .env. Generate a unique long password; never commit .env.
APP_PASSWORD=
APP_ORIGIN=http://localhost:8000
COOKIE_SECURE=false
DEMO_MODE=true
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
MAX_REQUESTS_HOUR=100
MAX_REQUESTS_DAY=200
MAX_REQUESTS_RUN=500
WORDSTAT_MAX_DATE=2026-10-07
# Required for real API: upper bound of one request and rolling 24h budget, in kopecks.
API_MAX_COST_KOPECKS=0
API_DAILY_BUDGET_KOPECKS=0
MAX_HTTP_CONCURRENT=8
